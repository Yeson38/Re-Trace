    "name": "test_bubble.cpp",
    "language": "cpp",
    "lines": [
      "#include <cstdio>",
      "",
      "void bubble_sort(int arr[], int n) {",
      "    for (int i = 0; i < n; i++) {",
      "        for (int j = 0; j < n - i - 1; j++) {",
      "            if (arr[j] > arr[j + 1]) {",
      "                int t = arr[j];",
      "                arr[j] = arr[j + 1];",
      "                arr[j + 1] = t;",
      "            }",
      "        }",
      "    }",
      "}",
      "",
      "int main() {",
      "    int data[] = {5, 2, 8, 1, 4};",
      "    int n = 5;",
      "    bubble_sort(data, n);",
      "    for (int i = 0; i < n; i++) printf(\"%d \", data[i]);",
      "    printf(\"\\n\");",
      "    return 0;",
      "}"
    ]
  },
