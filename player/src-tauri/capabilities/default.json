{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Re-Trace desktop default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-open",
    "fs:allow-read-file",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "/tmp/retrace_*" },
        { "path": "$TEMP/retrace_*" }
      ]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "python3", "cmd": "python3" },
        { "name": "g++", "cmd": "g++" }
      ]
    }
  ]
}
