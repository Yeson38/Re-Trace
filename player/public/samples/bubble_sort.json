  "source": {
    "name": "bubble_sort.py",
    "language": "python",
    "lines": [
      "def bubble_sort(arr):",
      "    n = len(arr)",
      "    for i in range(n):",
      "        for j in range(0, n - i - 1):",
      "            if arr[j] > arr[j + 1]:",
      "                arr[j], arr[j + 1] = arr[j + 1], arr[j]",
      "    return arr",
      "",
      "data = [5, 2, 8, 1, 4]",
      "result = bubble_sort(data)",
      "print(result)"
    ]
  },
